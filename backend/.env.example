# ---------------------------------------------------------------------------
# Copia este archivo a .env y ajusta los valores. NUNCA subas tu .env al repo.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# --- Base de datos ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymesis
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_DE_POSTGRES
# Pon true si tu proveedor exige TLS (Neon, Supabase, RDS...).
DB_SSL=false
DB_POOL_MAX=10

# --- JWT -------------------------------------------------------------------
# En produccion debe tener 32+ caracteres y ser aleatorio. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRY=7d

# --- Seguridad -------------------------------------------------------------
# Origenes permitidos por CORS, separados por comas.
# Vacio = se acepta cualquier origen (util solo detras de un proxy en el mismo dominio).
# En desarrollo se acepta cualquier puerto de localhost automaticamente.
# Esta lista solo hace falta en produccion o para dominios externos.
CORS_ORIGINS=

# Coste de bcrypt. Mas alto = mas lento de romper y mas lento de iniciar sesion.
BCRYPT_ROUNDS=12

# Limite de peticiones por ventana e IP.
RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=600

# Tamano maximo del cuerpo JSON aceptado.
JSON_BODY_LIMIT=100kb

# --- Datos iniciales -------------------------------------------------------
# Si la biblioteca global tiene menos ejercicios que esto, se rellena al arrancar.
EXERCISE_LIBRARY_TARGET=1400
